# ==============================================================================
# LQMarket Backend - Environment Configuration Template
# Sao chép file này thành .env trên VPS/Server và điền thông tin thực tế
# ==============================================================================

# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# Yêu cầu: Đã whitelist IP VPS (hoặc 0.0.0.0/0) trong MongoDB Atlas Network Access
MONGODB_URI=mongodb+srv://username:password@cluster0.your-id.mongodb.net/lqmarket?retryWrites=true&w=majority

# 2. SERVER & SECURITY
PORT=3000
NODE_ENV=production
JWT_SECRET=your_super_strong_random_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# 3. CORS CLIENT ALLOWED ORIGINS (cách nhau bởi dấu phẩy nếu có nhiều domain)
CLIENT_URL=https://cholienquan.com,http://localhost:5173,http://localhost:3000

# 4. CLOUDINARY (Lưu trữ ảnh tải lên - Tùy chọn)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 5. PAYOS PAYMENT GATEWAY (Thanh toán tự động VietQR - Tùy chọn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
