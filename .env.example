# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BACKEND DATABASE: MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/lqmarket?retryWrites=true&w=majority"

# AUTHENTICATION & SECURITY: JWT Secret & Configuration
JWT_SECRET="lqmarket_super_secure_jwt_secret_key_2026_production"
JWT_EXPIRES_IN="7d"

# CLIENT URL FOR CORS
CLIENT_URL="https://cholienquan.com"
PORT=3000

# FRONTEND API BASE URL
VITE_API_URL="/api"

# PAYOS CONFIGURATION: VietQR & Banking Payment Gateway
PAYOS_CLIENT_ID="70f0f30e-bb9a-4543-9e27-7afedef2c57a"
PAYOS_API_KEY="79d0ea14-7008-4556-a1b8-4c220f1e1bf9"
PAYOS_CHECKSUM_KEY="054a5db2d2ed9fad1554f7229dc97cbd33f2e73d06c7c86546ba83f713edeeda"

# STORAGE: Cloudinary / S3 (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SUPABASE CONFIGURATION (Legacy backup)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
