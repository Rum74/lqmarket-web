# ==============================================================================
# LQMarket - Environment Variables Template
# ==============================================================================

# 1. DATABASE CONFIGURATION (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.your-id.mongodb.net/lqmarket?retryWrites=true&w=majority

# 2. SERVER & SECURITY
PORT=3000
NODE_ENV=production
JWT_SECRET=your_super_strong_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 3. CORS & FRONTEND CLIENT
CLIENT_URL=https://cholienquan.com,http://localhost:5173,http://localhost:3000
VITE_API_URL=

# 4. PAYOS VIETQR PAYMENT GATEWAY (Optional)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# 5. CLOUDINARY IMAGE STORAGE (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

