rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true; // Allows demo/app sync and role toggling
    }

    // Account listings
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders & Escrow
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // Chat messages
    match /messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    // Wallet Transactions
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories & Taxonomy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Site Settings
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Mystery Boxes & Lucky Gacha
    match /mystery_boxes/{boxId} {
      allow read: if true;
      allow write: if true;
    }

    match /mystery_rewards/{rewardId} {
      allow read: if true;
      allow write: if true;
    }

    match /mystery_history/{historyId} {
      allow read: if true;
      allow write: if true;
    }

    match /user_inventory/{inventoryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
